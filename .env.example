# ============================================================================
# PlanGenie — Environment Variables
# The app runs fully offline with its built-in deterministic engine.
# Add a key below to switch the assistant, idea studio, quote analyzer and
# moodboard agent to Gemini (with automatic fallback to the local engine).
# Copy this file to .env and fill in the values you need.
# ============================================================================

# Server port (default 3000)
# PORT=3000

# AI is BYOK: users paste their own key in the app (🔑 button). Optionally set a server-side default:
# GEMINI_API_KEY=""
# ...or any provider: AI_PROVIDER=gemini|anthropic|openai|openrouter|custom
# AI_PROVIDER=""
# AI_API_KEY=""
# AI_MODEL=""
# AI_BASE_URL=""            # custom provider only (https)
# ALLOW_PRIVATE_AI_URLS=false   # true ONLY on your own machine for Ollama/LM Studio on localhost

# Identifies this app to OpenStreetMap Nominatim (usage policy). Use a real contact.
# NOMINATIM_CONTACT="you@example.com"

# Optional: requests per minute per IP on /api/agents (default 90)
# RATE_LIMIT_PER_MIN=90

# Optional: Google Maps JavaScript API key for the interactive venue map
# VITE_GOOGLE_MAPS_API_KEY=""

# ---- Production / deployment ----
# NODE_ENV=production            # set automatically by `npm start` and the Dockerfile
# ENCRYPTION_MASTER_KEY=""       # 32+ random chars (e.g. `openssl rand -base64 32`). Never commit it.
# TRUST_PROXY=1                  # number of reverse-proxy hops in front of the app (for correct client IPs)
# TRUST_TENANT_HEADER=false      # only set true behind an authenticating gateway that sets x-tenant-user-id

# ---- Legal pages (/privacy, /terms) — build-time, shown to users ----
# VITE_LEGAL_OPERATOR="Your Company or Name"
# VITE_LEGAL_EMAIL="privacy@example.com"
# VITE_LEGAL_ADDRESS="Street, City, Country"   # optional
# VITE_LEGAL_GOVERNING_LAW="the State of California, USA"   # optional
