# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plangenie"
# 32 random bytes, base64. Generate: npm run gen:master-key
ENCRYPTION_MASTER_KEY=""
# >= 32 chars. Signs session cookies.
AUTH_SECRET=""

# --- Optional ---
# Allow Ollama / OpenAI-compatible endpoints on localhost / private networks (dev only!)
ALLOW_PRIVATE_LLM_ENDPOINTS="false"
# Disable the "Vault mode" (server-side encrypted key storage) entirely
DISABLE_KEY_VAULT="false"
