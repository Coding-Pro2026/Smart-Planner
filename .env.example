# ============================================================================
# PlanGenie — Environment Variables
# The app runs fully offline with its built-in deterministic engine.
# Add a key below to switch the assistant, idea studio, quote analyzer and
# moodboard agent to Gemini (with automatic fallback to the local engine).
# Copy this file to .env and fill in the values you need.
# ============================================================================

# Server port (default 3000)
# PORT=3000

# Enables Gemini-powered planning (get a key at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=""

# Optional model overrides
# GEMINI_MODEL_FAST="gemini-2.5-flash"
# GEMINI_MODEL_LITE="gemini-2.5-flash-lite"
# GEMINI_MODEL_REASONING="gemini-2.5-flash"

# Optional: requests per minute per IP on /api/agents (default 90)
# RATE_LIMIT_PER_MIN=90

# Optional: Google Maps JavaScript API key for the interactive venue map
# VITE_GOOGLE_MAPS_API_KEY=""
